# Copy to .env for local overrides (api/settings.py reads .env automatically;
# .env is gitignored). Every one of these has a working default -- `uvicorn
# api.main:app` runs with zero configuration.

# SQLite by default, resolved relative to the repo root regardless of cwd.
# For Postgres: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./data/twin.db

# Comma-separated allowed origins, or "*" for any (the local/demo default).
CORS_ORIGINS=*

# Absolute or repo-relative path to field_params.json.
PARAMS_PATH=params/field_params.json

# development | production -- informational only today (no behaviour gate).
ENV=development

PORT=8000
